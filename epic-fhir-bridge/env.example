# ===========================================
# Insurabridge Epic FHIR Bridge Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration (generate a random 32+ char string)
SESSION_SECRET=your-secure-random-session-secret-here

# Epic SMART-on-FHIR Configuration
# ---------------------------------
# OPTION 1: Use Epic's Open Sandbox (NO REGISTRATION REQUIRED)
# This is Epic's public test client ID - works out of the box!
EPIC_CLIENT_ID=6c12dff4-24e7-4475-a742-b08972c4ea27

# OPTION 2: Register your own app at https://fhir.epic.com/
# - Click "Build Apps" → "Create"  
# - Set Application Audience: Patients
# - Add Redirect URI: http://localhost:3000/callback
# - Copy your Non-Production Client ID here
# EPIC_CLIENT_ID=your-registered-client-id

# Epic FHIR R4 Base URL (Sandbox)
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# Epic OAuth Endpoints (Sandbox)
EPIC_AUTH_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# Redirect URI - must exactly match what's registered in Epic
# For local development, use http://localhost:3000/callback
REDIRECT_URI=http://localhost:3000/callback

# FHIR Scopes (space-separated)
# MINIMAL scopes for initial testing (recommended to start):
FHIR_SCOPES=launch/patient openid fhirUser patient/Patient.read

# FULL scopes (use once basic auth works):
# FHIR_SCOPES=launch/patient patient/Patient.read patient/Coverage.read patient/ExplanationOfBenefit.read patient/Condition.read patient/Observation.read openid fhirUser offline_access

# Logging
LOG_LEVEL=debug

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:8000

