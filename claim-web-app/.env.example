# Application
APP_NAME=Claims Automation Platform
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_THIS_TO_RANDOM_256_BIT_KEY_IN_PRODUCTION
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://claims_user:claims_password@postgres:5432/claims_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Security
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
SESSION_TIMEOUT_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# Epic EHR
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
EPIC_REDIRECT_URI=http://localhost:8000/auth/epic/callback
EPIC_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_AUTH_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# Cerner EHR
CERNER_CLIENT_ID=your_cerner_client_id
CERNER_CLIENT_SECRET=your_cerner_client_secret
CERNER_REDIRECT_URI=http://localhost:8000/auth/cerner/callback
CERNER_FHIR_BASE=https://fhir-myrecord.cerner.com/r4
CERNER_AUTH_URL=https://authorization.cerner.com/oauth2/authorize
CERNER_TOKEN_URL=https://authorization.cerner.com/oauth2/token

# eClinicalWorks
ECLINICALWORKS_CLIENT_ID=your_ecw_client_id
ECLINICALWORKS_CLIENT_SECRET=your_ecw_client_secret
ECLINICALWORKS_REDIRECT_URI=http://localhost:8000/auth/eclinicalworks/callback
ECLINICALWORKS_FHIR_BASE=https://fhir.eclinicalworks.com/fhir/r4
ECLINICALWORKS_AUTH_URL=https://oauth.eclinicalworks.com/authorize
ECLINICALWORKS_TOKEN_URL=https://oauth.eclinicalworks.com/token

# Athenahealth
ATHENAHEALTH_CLIENT_ID=your_athena_client_id
ATHENAHEALTH_CLIENT_SECRET=your_athena_client_secret
ATHENAHEALTH_REDIRECT_URI=http://localhost:8000/auth/athenahealth/callback
ATHENAHEALTH_FHIR_BASE=https://fhir.platform.athenahealth.com/fhir/r4
ATHENAHEALTH_AUTH_URL=https://api.platform.athenahealth.com/oauth2/v1/authorize
ATHENAHEALTH_TOKEN_URL=https://api.platform.athenahealth.com/oauth2/v1/token

# Meditech
MEDITECH_CLIENT_ID=your_meditech_client_id
MEDITECH_CLIENT_SECRET=your_meditech_client_secret
MEDITECH_REDIRECT_URI=http://localhost:8000/auth/meditech/callback
MEDITECH_FHIR_BASE=https://fhir.meditech.com/api/fhir/r4
MEDITECH_AUTH_URL=https://fhir.meditech.com/oauth/authorize
MEDITECH_TOKEN_URL=https://fhir.meditech.com/oauth/token

# Local LLM Service
LLM_SERVICE_URL=http://localhost:8001
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Data Retention (days)
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555
SESSION_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (for session storage)
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_PREFIX=session:

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_MOCK_EHR=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ANALYTICS=false
